<?xml version="1.0" encoding="UTF-8"?>
<module id="com.intechcore.polarion.extension.github" version="1.0.0">

    <contribution configuration-id="com.polarion.xray.webui.administrationPageExtenders">
        <extender id="about"
                  name="About"
                  parentNodeId="github"
                  parentNodeName="GitHub"
                  parentNodeIconUrl="/polarion/github-app/ui/images/menu/30x30/_parent.svg"
                  iconUrl="/polarion/github-app/ui/images/menu/16x16/about.svg"
                  pageUrl="/polarion/github-app/ui/app/index.html?feature=about&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="repositories"
                  name="Repositories"
                  parentNodeId="github"
                  iconUrl="/polarion/github-app/ui/images/menu/16x16/repositories.svg"
                  pageUrl="/polarion/github-app/ui/app/index.html?feature=repositories&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="false"/>

        <extender id="import"
                  name="Issues and Discussions"
                  parentNodeId="github"
                  iconUrl="/polarion/github-app/ui/images/menu/16x16/import.svg"
                  pageUrl="/polarion/github-app/ui/app/index.html?feature=items&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="false"/>

        <extender id="restapi"
                  name="REST API"
                  parentNodeId="github"
                  iconUrl="/polarion/github-app/ui/images/menu/16x16/rest_api.svg"
                  pageUrl="/polarion/github/rest/swagger"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>
    </contribution>

    <!-- The topic GitHub in the navigation of a project, the same page as the administration entry. -->
    <contribution configuration-id="com.polarion.xray.webui.customNavigationExtenders">
        <extenders extender="githubNavigationExtender"/>
    </contribution>

    <service-point id="githubNavigationExtender" interface="com.polarion.alm.ui.server.navigation.NavigationExtender">
        <invoke-factory>
            <construct class="com.intechcore.polarion.extension.github.GithubNavigationExtender"/>
        </invoke-factory>
    </service-point>

    <!-- github_watch.job: mails new GitHub items. The global scheduler runs it, every 15 minutes by default. -->
    <service-point id="githubWatchJobUnitFactory" interface="com.polarion.platform.jobs.IJobUnitFactory">
        <invoke-factory>
            <construct class="com.intechcore.polarion.extension.github.job.GithubWatchJobUnitFactory"/>
        </invoke-factory>
    </service-point>

    <contribution configuration-id="com.polarion.platform.jobs.configuration">
        <jobUnitFactory name="github_watch.job" factory="githubWatchJobUnitFactory"/>
    </contribution>

    <!-- @GitHubRepositories: the repository settings of a project, for the widget's multi-select. -->
    <contribution configuration-id="com.polarion.platform.persistence.dataservice.typedInterfacesConfig">
        <enum id="@GitHubRepositories" factory="GithubRepositoriesEnumFactory"/>
    </contribution>

    <service-point id="GithubRepositoriesEnumFactory" interface="com.polarion.platform.persistence.IEnumFactory" visibility="private">
        <invoke-factory>
            <construct class="com.intechcore.polarion.extension.github.widget.RepositoriesEnumFactory"/>
        </invoke-factory>
    </service-point>

    <contribution configuration-id="com.polarion.alm.richpages.widgets">
        <widget id="com.intechcore.polarion.extension.github.widget.GithubItemsWidget" instance="instance:com.intechcore.polarion.extension.github.widget.GithubItemsWidget"/>
    </contribution>

</module>
