{
  "openapi": "3.0.1",
  "paths": {
    "/api/configuration-properties": {
      "get": {
        "operationId": "getConfigurationProperties",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationPropertiesModel"
                }
              }
            },
            "description": "Configuration properties"
          }
        },
        "summary": "Returns the extension configuration properties (active and obsolete)",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/configuration-status": {
      "get": {
        "operationId": "getConfigurationStatus",
        "parameters": [
          {
            "description": "Scope to evaluate the status for, e.g. 'project/elibrary/'",
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConfigurationStatus"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Configuration status entries"
          }
        },
        "summary": "Returns the extension configuration status for the given scope",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/context": {
      "get": {
        "operationId": "getContext",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            },
            "description": "Context information"
          }
        },
        "summary": "Returns basic context information of Polarion's extension",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/disclaimer": {
      "get": {
        "operationId": "getDisclaimer",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "HTML help article"
          }
        },
        "summary": "Returns the build-generated DISCLAIMER help article shown on the Usage Disclaimer page",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/projects/{projectId}/items": {
      "get": {
        "operationId": "getItems",
        "parameters": [
          {
            "description": "The project",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectItems"
                }
              }
            },
            "description": "default response"
          }
        },
        "summary": "Returns the open issues and discussions of all repository settings of a project, with what the import would do with each",
        "tags": [
          "Import"
        ]
      }
    },
    "/api/projects/{projectId}/link-roles": {
      "get": {
        "operationId": "getLinkRoles",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectOption"
                  },
                  "type": "array"
                }
              }
            },
            "description": "default response"
          }
        },
        "summary": "Returns the work item link roles of a project",
        "tags": [
          "Project options"
        ]
      }
    },
    "/api/projects/{projectId}/repositories/{name}/import": {
      "post": {
        "operationId": "importRepository",
        "parameters": [
          {
            "description": "The project that gets the work items",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The name of the repository setting",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "True to report only what the import would do",
            "in": "query",
            "name": "dryRun",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          }
        },
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            },
            "description": "default response"
          }
        },
        "summary": "Creates work items from the open issues and discussions of a configured repository",
        "tags": [
          "Import"
        ]
      }
    },
    "/api/projects/{projectId}/workitem-types": {
      "get": {
        "operationId": "getWorkItemTypes",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectOption"
                  },
                  "type": "array"
                }
              }
            },
            "description": "default response"
          }
        },
        "summary": "Returns the work item types of a project",
        "tags": [
          "Project options"
        ]
      }
    },
    "/api/projects/{projectId}/workitem-types/{workItemType}/fields": {
      "get": {
        "operationId": "getFields",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "workItemType",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectField"
                  },
                  "type": "array"
                }
              }
            },
            "description": "default response"
          }
        },
        "summary": "Returns the fields of a work item type of a project",
        "tags": [
          "Project options"
        ]
      }
    },
    "/api/readme": {
      "get": {
        "operationId": "getDocumentation",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "HTML help article"
          }
        },
        "summary": "Returns the build-generated README help article shown on the About page",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/user-guide": {
      "get": {
        "operationId": "getUserGuide",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "HTML help article"
          }
        },
        "summary": "Returns the build-generated USER_GUIDE help article shown on the User Guide page",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            },
            "description": "Version information"
          }
        },
        "summary": "Returns version of Polarion's extension",
        "tags": [
          "Extension Information"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigurationPropertiesModel": {
        "description": "Extension configuration properties shown on the About page",
        "properties": {
          "obsoleteProperties": {
            "description": "Obsolete or non-valid configuration properties (only key and value are set), sorted by key",
            "items": {
              "$ref": "#/components/schemas/ConfigurationPropertyModel"
            },
            "type": "array"
          },
          "properties": {
            "description": "Active configuration properties, sorted by key",
            "items": {
              "$ref": "#/components/schemas/ConfigurationPropertyModel"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ConfigurationPropertyModel": {
        "description": "A single extension configuration property as shown on the About page",
        "properties": {
          "defaultValue": {
            "description": "Default value of the property, if any",
            "type": "string"
          },
          "description": {
            "description": "Human readable description of the property, if any",
            "type": "string"
          },
          "key": {
            "description": "Property key",
            "type": "string"
          },
          "value": {
            "description": "Current value of the property",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigurationStatus": {
        "properties": {
          "details": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "OK",
              "WARNING",
              "ERROR"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Context": {
        "description": "Represents the context for building URLs related to Polarion services",
        "properties": {
          "baseUrl": {
            "description": "Returns the base URL constructed with the extension context",
            "type": "string"
          },
          "extensionContext": {
            "description": "The extension context used as a base for URL construction",
            "type": "string"
          },
          "restUrl": {
            "description": "Returns the REST API URL constructed with the extension context",
            "type": "string"
          },
          "swaggerUiUrl": {
            "description": "Returns the Swagger UI URL for the REST API",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ImportEntry": {
        "description": "The outcome of the import for one GitHub item",
        "properties": {
          "assignees": {
            "description": "The GitHub logins the item is assigned to",
            "items": {
              "description": "The GitHub logins the item is assigned to",
              "type": "string"
            },
            "type": "array"
          },
          "githubType": {
            "description": "The issue type, or the category of a discussion",
            "type": "string"
          },
          "kind": {
            "description": "Issue or discussion",
            "enum": [
              "ISSUE",
              "DISCUSSION"
            ],
            "type": "string"
          },
          "labels": {
            "description": "The labels of the item",
            "items": {
              "description": "The labels of the item",
              "type": "string"
            },
            "type": "array"
          },
          "message": {
            "description": "The reason of a failure",
            "type": "string"
          },
          "number": {
            "description": "The number of the item in its repository",
            "format": "int64",
            "type": "integer"
          },
          "repository": {
            "description": "The repository as owner/name",
            "type": "string"
          },
          "setting": {
            "description": "The name of the repository setting",
            "type": "string"
          },
          "status": {
            "description": "What the import did, or would do",
            "enum": [
              "NEW",
              "CREATED",
              "EXISTS",
              "SKIPPED",
              "FAILED"
            ],
            "type": "string"
          },
          "title": {
            "description": "The title of the item on GitHub",
            "type": "string"
          },
          "url": {
            "description": "The URL of the item on GitHub",
            "type": "string"
          },
          "workItemAssignees": {
            "description": "The names of the users the work item is assigned to",
            "items": {
              "description": "The names of the users the work item is assigned to",
              "type": "string"
            },
            "type": "array"
          },
          "workItemId": {
            "description": "The ID of the work item, when one exists or was created",
            "type": "string"
          },
          "workItemStatus": {
            "description": "The status of the work item",
            "type": "string"
          },
          "workItemType": {
            "description": "The ID of the work item type: of the work item, or the one the import would create",
            "type": "string"
          },
          "workItemTypeName": {
            "description": "The name of that work item type",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ImportRequest": {
        "description": "Which items of a repository to import",
        "properties": {
          "urls": {
            "description": "The GitHub URLs to import. Leave it out to import every open item.",
            "items": {
              "description": "The GitHub URLs to import. Leave it out to import every open item.",
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ImportResult": {
        "description": "The outcome of the import of one repository",
        "properties": {
          "dryRun": {
            "description": "Whether the import only reported what it would do",
            "type": "boolean"
          },
          "entries": {
            "description": "One entry per GitHub item",
            "items": {
              "$ref": "#/components/schemas/ImportEntry"
            },
            "type": "array"
          },
          "readAt": {
            "description": "When the oldest list of the repository was read from GitHub, as an ISO-8601 instant. Lists serve from a cache for five minutes.",
            "type": "string"
          },
          "repository": {
            "description": "The repository as owner/name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProjectField": {
        "description": "A work item field of a project",
        "properties": {
          "custom": {
            "description": "Whether the field is a custom field",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "urlKey": {
            "description": "Whether the field can keep the URL of a GitHub item: a custom field of the type String",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ProjectItems": {
        "description": "The open GitHub items of all repository settings of a project",
        "properties": {
          "entries": {
            "description": "The open issues and discussions, with what the import would do with each",
            "items": {
              "$ref": "#/components/schemas/ImportEntry"
            },
            "type": "array"
          },
          "repositories": {
            "description": "One state per repository setting",
            "items": {
              "$ref": "#/components/schemas/RepositoryState"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ProjectOption": {
        "description": "A work item type or a link role of a project",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RepositoryState": {
        "description": "How the reading of one repository setting went",
        "properties": {
          "error": {
            "description": "Why the repository could not be read",
            "type": "string"
          },
          "readAt": {
            "description": "When the oldest list of the repository was read from GitHub, as an ISO-8601 instant",
            "type": "string"
          },
          "repository": {
            "description": "The repository as owner/name",
            "type": "string"
          },
          "setting": {
            "description": "The name of the repository setting",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Version": {
        "description": "Details about the software version",
        "properties": {
          "automaticModuleName": {
            "description": "The automatic module name",
            "type": "string"
          },
          "bundleBuildTimestamp": {
            "description": "The build timestamp of the bundle",
            "type": "string"
          },
          "bundleName": {
            "description": "The name of the bundle",
            "type": "string"
          },
          "bundleVendor": {
            "description": "The vendor of the bundle",
            "type": "string"
          },
          "bundleVersion": {
            "description": "The version of the bundle",
            "type": "string"
          },
          "projectURL": {
            "description": "The project URL",
            "type": "string"
          },
          "supportEmail": {
            "description": "Support email for the bundle",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
